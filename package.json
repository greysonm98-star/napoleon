{
  "name": "napoleon",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p packages/engine --noEmit && tsc -p packages/cli --noEmit && tsc -p packages/ui --noEmit",
    "napsim": "tsx packages/cli/src/main.ts",
    "ui": "vite packages/ui",
    "build:ui": "vite build packages/ui"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
